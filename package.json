{
  "name": "@sunaissu/thyncspace-frontend",
  "version": "2.0.0",
  "description": "Private progressive web app frontend for ThyncSpace.",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "dev": "next dev --webpack",
    "dev:dual-account": "node scripts/dual-account-dev.cjs",
    "build": "next build --webpack && node discovery/build.mjs",
    "lint": "eslint . --max-warnings=0",
    "test": "node --test test/*.test.cjs",
    "test:documentation": "node scripts/documentation-review.cjs",
    "test:documentation-export": "node scripts/documentation-export-review.cjs",
    "test:documentation-collaboration": "node scripts/documentation-collaboration-review.cjs",
    "test:browser": "node scripts/browser-review.cjs",
    "test:recovery": "node scripts/recovery-review.cjs",
    "test:live": "node scripts/live-review.cjs",
    "test:presence": "node scripts/presence-review.cjs",
    "test:links": "node scripts/links-review.cjs",
    "test:schedules": "node scripts/schedules-review.cjs",
    "test:capture": "node scripts/capture-review.cjs",
    "test:privacy": "node scripts/privacy-review.cjs",
    "test:security": "node scripts/security-review.cjs",
    "test:activity": "node scripts/activity-review.cjs",
    "test:study": "node scripts/study-review.cjs",
    "predev": "node scripts/prepare-pdf.cjs && node scripts/prepare-ocr.cjs && node scripts/prepare-companion.cjs",
    "prebuild": "node scripts/prepare-pdf.cjs && node scripts/prepare-ocr.cjs && node scripts/prepare-companion.cjs",
    "test:attachments": "node scripts/attachments-review.cjs",
    "test:ocr": "node scripts/ocr-review.cjs",
    "test:reminders": "node scripts/reminders-review.cjs",
    "test:offline": "node scripts/offline-review.cjs",
    "test:embeds": "node scripts/embeds-review.cjs",
    "test:discussions": "node scripts/discussions-review.cjs",
    "test:notebooks": "node scripts/notebooks-review.cjs",
    "test:ai": "node scripts/ai-review.cjs",
    "test:archive": "node scripts/archive-review.cjs",
    "test:companion": "node scripts/companion-review.cjs",
    "test:auth-policy": "node scripts/auth-policy-review.cjs",
    "test:foundation": "node scripts/foundation-review.cjs",
    "test:technical": "node scripts/technical-review.cjs"
  },
  "dependencies": {
    "@hocuspocus/provider": "4.5.0",
    "@phosphor-icons/react": "^2.1.10",
    "@sunaissu/calculator": "file:vendor/sunaissu-calculator-1.1.0-rc.2.tgz",
    "@sunaissu/document-editor": "file:vendor/sunaissu-document-editor-1.1.0-rc.5.tgz",
    "@sunaissu/noteboard": "file:vendor/sunaissu-noteboard-3.0.0-rc.2.tgz",
    "@tesseract.js-data/eng": "^1.0.0",
    "docx": "9.12.0",
    "jspdf": "4.2.1",
    "next": "^16.4.3",
    "pdfjs-dist": "^6.4.299",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tesseract.js": "^7.0.0",
    "yjs": "^13.6.31"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "20.19.43",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "docx-preview": "0.4.1",
    "esbuild": "0.28.1",
    "eslint": "9.39.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "14.0.0",
    "postcss": "8.5.25",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0"
  },
  "overrides": {
    "postcss-selector-parser": "7.1.6"
  }
}
